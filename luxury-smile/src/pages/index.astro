---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import TaglineReveal from '../components/TaglineReveal.astro';
import Treatments from '../components/Treatments.astro';
import FirstVisit from '../components/FirstVisit.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { scenes } from '../data/scenes';
---

<Layout>
	<link slot="head" rel="preload" as="image" href={`/videos/posters/${scenes[0].clip}.webp`} fetchpriority="high" />
	<div id="top"></div>
	<SiteHeader />
	<ScrollWorld />

	<main id="contenido" class="page">
		<TaglineReveal text="Odontología y estética en un mismo lugar, con el trato cercano que mereces." />
		<Treatments />
		<FirstVisit />
		<Contact />
	</main>
	<SiteFooter />
</Layout>
