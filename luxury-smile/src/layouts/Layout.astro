---
import { Font } from 'astro:assets';
import { clinic } from '../data/clinic';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = `${clinic.name} · ${clinic.tagline}`,
	description = 'Clínica dental y estética. Cuidamos de tu salud bucodental con atención personalizada y tecnología avanzada.',
	image = '/videos/posters/clip-01.webp',
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="theme-color" content="#131209" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={clinic.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<Font cssVariable="--font-manrope" preload />
		<noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
	</body>
</html>

<script>
	// Las secciones suben 32px y aparecen una sola vez al entrar en pantalla.
	const items = document.querySelectorAll('.reveal');
	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
		items.forEach((el) => el.classList.add('is-visible'));
	} else {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						io.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);
		items.forEach((el) => io.observe(el));
	}
</script>

<style is:global>
	/* Paleta oscura cálida sacada de los clips: el vídeo es el protagonista y el rosado
	   de las escenas (#D99992, #E2ADA1) hace de acento. */
	:root {
		--bg: #131209;
		--surface: #1f1f1f;
		--surface-raised: #272727;
		--glass: color-mix(in srgb, #131209 62%, transparent);
		--ink: #f5efea;
		--ink-soft: #b9aea6;
		--accent: #e2ada1;
		--accent-ink: #131209;
		--line: color-mix(in srgb, #ffffff 10%, transparent);
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
		--font: var(--font-manrope);
		color-scheme: dark;
	}

	/* Titulares destacados: degradado de texto de izquierda a derecha. */
	.text-gradient {
		background: linear-gradient(90deg, #ffffff, #9b9b9b);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	html {
		background: var(--bg);
		color: var(--ink);
		font-family: var(--font);
		-webkit-font-smoothing: antialiased;
	}

	body {
		margin: 0;
		background: var(--bg);
	}

	h1,
	h2,
	h3 {
		text-wrap: balance;
	}

	p,
	li {
		text-wrap: pretty;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 4px;
	}

	.skip-link {
		position: fixed;
		top: 8px;
		left: 8px;
		z-index: 1000;
		padding: 8px 12px;
		border-radius: 8px;
		background: var(--accent);
		color: var(--accent-ink);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-200%);
		transition: transform 300ms var(--ease);
	}

	.skip-link:focus {
		transform: none;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* El contenido normal va por encima de las capas fijas de la película. Es transparente:
	   detrás queda el último fotograma del recorrido, difuminado (ver ScrollWorld). */
	.page,
	.footer {
		position: relative;
		z-index: 30;
	}

	/* Botón principal compartido. */
	.btn {
		display: inline-block;
		padding: 8px 16px;
		border-radius: 9999px;
		background: var(--accent);
		color: var(--accent-ink);
		font-size: 1rem;
		line-height: 1.5rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform 300ms var(--ease);
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn:active {
		transform: scale(0.98);
	}

	.btn.is-disabled {
		opacity: 0.4;
		cursor: not-allowed;
		transform: none;
	}

	/* Datos aún sin rellenar: visibles pero marcados. */
	.pending {
		color: #f3c99b;
		background: color-mix(in srgb, #f3c99b 10%, transparent);
		border: 1px dashed color-mix(in srgb, #f3c99b 50%, transparent);
		border-radius: 8px;
		padding: 4px 8px;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.reveal {
		opacity: 0;
		transform: translateY(32px);
		transition:
			opacity 700ms var(--ease),
			transform 700ms var(--ease);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			transform: none;
			transition: opacity 300ms var(--ease);
		}
	}
</style>
