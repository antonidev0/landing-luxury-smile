---
// Película scroll-world: la posición del scroll controla el tiempo de los clips.
// El motor (src/scripts/scroll-world.js) construye su propio DOM dentro de #world.
// La cabecera es SiteHeader.astro (HTML estático), así que el motor no pinta la suya.
import { scenes } from '../data/scenes';
---

<div id="world" class="world" aria-label="Recorrido por la clínica">
	<!-- Al terminar el recorrido, el último fotograma queda de fondo, oscurecido y difuminado. -->
	<div class="world-scrim" aria-hidden="true"></div>
</div>

<noscript>
	<div class="world-static">
		{
			scenes.map((s, i) => (
				<section class="world-static__scene">
					<img src={`/videos/posters/${s.clip}.webp`} alt="" width="1920" height="1080" loading="lazy" />
					<div>
						<p class="world-static__eyebrow">{s.eyebrow}</p>
						{i === 0 ? <h1>{s.title}</h1> : <h2>{s.title}</h2>}
						<p>{s.body}</p>
					</div>
				</section>
			))
		}
	</div>
</noscript>

<script>
	import { mountScrollWorld } from '../scripts/scroll-world.js';
	import { scenes } from '../data/scenes';

	// Conexiones lentas o con ahorro de datos: solo imágenes fijas, sin descargar vídeo.
	const conn = (navigator as any).connection;
	const lite = !!(conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '')));

	const world = document.getElementById('world');
	if (world) {
		const api = mountScrollWorld(world, {
			nav: false,
			hint: 'Desliza para entrar',
			firstHeading: 'h1',
			atmosphere: false,
			crossfade: 0.1,
			doneAt: 0,
			lite,
			sections: scenes.map((s) => ({
				id: s.id,
				label: s.label,
				still: `/videos/posters/${s.clip}.webp`,
				clip: `/videos/${s.clip}.webm`,
				clipMobile: `/videos/${s.clip}-m.webm`,
				clipFallback: `/videos/${s.clip}.mp4`,
				accent: s.accent,
				scroll: s.scroll,
				linger: s.linger,
				eyebrow: s.eyebrow,
				title: s.title,
				body: s.body,
				tags: s.tags,
				cta: s.cta,
			})),
			connectors: [],
		});

		// Los enlaces "#escena-<id>" llevan a la escena dentro del recorrido.
		document.addEventListener('click', (e) => {
			const link = (e.target as HTMLElement).closest('a[href^="#escena-"]');
			if (!link || !api) return;
			const index = scenes.findIndex((s) => `#escena-${s.id}` === link.getAttribute('href'));
			if (index < 0) return;
			e.preventDefault();
			api.jumpTo(index);
		});
	}
</script>

<style is:global>
	/* Tema del motor scroll-world (sus estilos base viven en @layer sw, estos ganan). */
	.sw-root {
		--sw-bg: var(--bg);
		--sw-ink: var(--ink);
		--sw-ink-soft: var(--ink-soft);
		--sw-accent: var(--accent);
		--sw-font-display: var(--font);
		--sw-font-body: var(--font);
	}

	.sw-particles,
	.sw-copylayer::before {
		display: none;
	}

	/* La cabecera la pone SiteHeader; la barra del motor queda vacía. */
	.sw-topbar {
		display: none;
	}

	/* Texto sobre el vídeo: panel de cristal oscuro, siempre legible. */
	.sw-copy {
		width: min(44vw, 560px);
		padding: 40px;
		border-radius: 32px;
		background: var(--glass);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid var(--line);
		box-sizing: border-box;
	}

	.sw-copy__num {
		font-size: 0.75rem;
		line-height: 1rem;
		color: var(--ink-soft);
	}

	.sw-copy__eyebrow {
		margin-top: 16px;
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.sw-copy__title {
		margin-top: 12px;
		font-size: 3rem;
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-shadow: none;
	}

	h1.sw-copy__title {
		font-size: 3.75rem;
		background: linear-gradient(90deg, #ffffff, #9b9b9b);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.sw-copy__body {
		margin: 16px 0 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
		color: var(--ink-soft);
		text-shadow: none;
	}

	.sw-copy__tags {
		margin-top: 24px;
	}

	.sw-copy__tags li {
		font-size: 0.875rem;
		line-height: 1.25rem;
		padding: 4px 12px;
		color: var(--ink);
		background: color-mix(in srgb, var(--sw-accent) 14%, transparent);
		border: 1px solid color-mix(in srgb, var(--sw-accent) 35%, transparent);
	}

	.sw-copy__cta {
		margin-top: 32px;
	}

	.sw-btn {
		font-size: 1rem;
		line-height: 1.5rem;
		font-weight: 600;
		padding: 8px 16px;
		transition: transform 300ms var(--ease), background-color 300ms var(--ease);
	}

	.sw-btn--primary {
		color: var(--accent-ink);
		background: var(--accent);
	}

	.sw-btn--ghost {
		color: var(--ink);
		border-color: var(--line);
	}

	.sw-btn:active {
		transform: scale(0.98);
	}

	.sw-route__label {
		color: var(--ink);
		background: var(--glass);
		border-color: var(--line);
	}

	.sw-route__dot i {
		background: color-mix(in srgb, var(--ink) 35%, transparent);
	}

	.sw-hint {
		color: var(--ink);
	}

	.sw-hint i {
		border-color: color-mix(in srgb, var(--ink) 50%, transparent);
	}

	/* Al terminar el recorrido el vídeo se queda quieto de fondo y el resto se aparta. */
	.world-scrim {
		position: fixed;
		inset: 0;
		z-index: 15;
		pointer-events: none;
		opacity: 0;
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(32px) saturate(1.2);
		-webkit-backdrop-filter: blur(32px) saturate(1.2);
		transition: opacity 700ms var(--ease);
	}

	.sw-root.sw-done .world-scrim {
		opacity: 1;
	}

	.sw-copylayer,
	.sw-route,
	.sw-hint,
	.sw-scrollbar {
		transition: opacity 500ms var(--ease), visibility 500ms;
	}

	.sw-root.sw-done .sw-copylayer,
	.sw-root.sw-done .sw-route,
	.sw-root.sw-done .sw-hint,
	.sw-root.sw-done .sw-scrollbar {
		opacity: 0 !important;
		visibility: hidden;
	}

	@media (max-width: 860px) {
		/* En móvil la barra de progreso superior basta; los puntos tapaban el texto. */
		.sw-route {
			display: none;
		}

		.sw-copy {
			width: auto;
			padding: 24px;
			border-radius: 24px;
		}

		.sw-copy__title,
		h1.sw-copy__title {
			font-size: 1.875rem;
			line-height: 2.25rem;
		}

		.sw-copy__body {
			font-size: 1rem;
			line-height: 1.5rem;
		}
	}

	.world-static__scene {
		display: grid;
		gap: 24px;
		padding: 48px 16px;
		max-width: 1080px;
		margin: 0 auto;
	}

	.world-static__scene img {
		width: 100%;
		height: auto;
		border-radius: 24px;
	}

	.world-static__eyebrow {
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
</style>
