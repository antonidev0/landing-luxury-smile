---
import { clinic, isPending } from '../data/clinic';

// El CTA solo enlaza cuando hay un dato real de contacto; si no, se muestra deshabilitado.
const ctaHref = clinic.phoneHref
	? `tel:${clinic.phoneHref}`
	: !isPending(clinic.email)
		? `mailto:${clinic.email}`
		: null;
const pending = (v: string) => (isPending(v) ? 'pending' : undefined);
---

<section id="contacto" class="contact reveal" aria-labelledby="contacto-title">
	<div class="contact__panel">
		<div class="contact__intro">
			<p class="eyebrow">Pide tu cita</p>
			<h2 id="contacto-title" class="text-gradient">Estamos aquí para cuidar de tu sonrisa</h2>
			<p class="contact__lead">
				Cuéntanos qué necesitas y te proponemos una primera visita para valorar tu caso sin prisas.
			</p>
			{
				ctaHref ? (
					<a class="btn" href={ctaHref}>
						Contactar con la clínica
					</a>
				) : (
					<span class="btn is-disabled" aria-disabled="true">
						Contactar con la clínica
					</span>
				)
			}
		</div>

		<dl class="contact__data">
			<div>
				<dt>Dirección</dt>
				<dd class={pending(clinic.address)}>
					{clinic.mapsUrl ? <a href={clinic.mapsUrl}>{clinic.address}</a> : clinic.address}
				</dd>
			</div>
			<div>
				<dt>Teléfono</dt>
				<dd class={pending(clinic.phone)}>
					{clinic.phoneHref ? <a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a> : clinic.phone}
				</dd>
			</div>
			<div>
				<dt>Email</dt>
				<dd class={pending(clinic.email)}>
					{isPending(clinic.email) ? clinic.email : <a href={`mailto:${clinic.email}`}>{clinic.email}</a>}
				</dd>
			</div>
			<div>
				<dt>Horario</dt>
				{
					clinic.hours.map((h) => (
						<dd class={pending(h.days)}>
							{h.days} · {h.time}
						</dd>
					))
				}
			</div>
			{
				clinic.social.length > 0 && (
					<div>
						<dt>Redes</dt>
						{clinic.social.map((s) => (
							<dd>
								<a href={s.href} rel="noopener">
									{s.label}
								</a>
							</dd>
						))}
					</div>
				)
			}
		</dl>
	</div>
</section>

<style>
	.contact {
		max-width: 1200px;
		margin: 0 auto;
		padding: 96px 32px;
	}

	/* Panel de cristal oscuro sobre el fondo del recorrido. */
	.contact__panel {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		padding: 64px;
		border-radius: 32px;
		background: var(--glass);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		border: 1px solid var(--line);
	}

	.contact h2 {
		margin: 12px 0 0;
		font-size: 3rem;
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.contact__lead {
		margin: 16px 0 0;
		max-width: 440px;
		font-size: 1.125rem;
		line-height: 1.75rem;
		color: var(--ink-soft);
	}

	.contact .btn {
		margin-top: 32px;
	}

	.contact__data {
		margin: 0;
		display: grid;
		gap: 24px;
		align-content: start;
	}

	.contact__data > div {
		padding-bottom: 24px;
		border-bottom: 1px solid var(--line);
	}

	.contact__data > div:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}

	.contact__data dt {
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		color: var(--ink-soft);
	}

	.contact__data dd {
		margin: 4px 0 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
	}

	.contact__data dd.pending {
		display: inline-block;
	}

	.contact__data a {
		color: var(--ink);
		text-decoration-color: var(--accent);
		text-underline-offset: 4px;
	}

	@media (max-width: 860px) {
		.contact {
			padding: 64px 16px;
		}

		.contact__panel {
			grid-template-columns: 1fr;
			gap: 48px;
			padding: 32px 24px;
			border-radius: 24px;
		}

		.contact h2 {
			font-size: 2.25rem;
			line-height: 2.5rem;
		}
	}
</style>
