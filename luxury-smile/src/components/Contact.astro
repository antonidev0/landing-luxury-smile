---
import { clinic, isPending } from '../data/clinic';

// El CTA solo enlaza cuando hay un dato real de contacto; si no, se muestra deshabilitado.
const ctaHref = clinic.phoneHref
	? `tel:${clinic.phoneHref}`
	: !isPending(clinic.email)
		? `mailto:${clinic.email}`
		: null;
const pending = (v: string) => (isPending(v) ? 'pending' : undefined);
---

<section id="contacto" class="contact reveal" aria-labelledby="contacto-title">
	<div class="contact__intro">
		<p class="eyebrow">{clinic.name} · {clinic.tagline}</p>
		<h2 id="contacto-title">Estamos aquí para cuidar de tu sonrisa</h2>
		{
			ctaHref ? (
				<a class="btn" href={ctaHref}>
					Contactar con la clínica
				</a>
			) : (
				<span class="btn is-disabled" aria-disabled="true">
					Contactar con la clínica
				</span>
			)
		}
	</div>

	<dl class="contact__data">
		<div>
			<dt>Dirección</dt>
			<dd class={pending(clinic.address)}>
				{clinic.mapsUrl ? <a href={clinic.mapsUrl}>{clinic.address}</a> : clinic.address}
			</dd>
		</div>
		<div>
			<dt>Teléfono</dt>
			<dd class={pending(clinic.phone)}>
				{clinic.phoneHref ? <a href={`tel:${clinic.phoneHref}`}>{clinic.phone}</a> : clinic.phone}
			</dd>
		</div>
		<div>
			<dt>Email</dt>
			<dd class={pending(clinic.email)}>
				{isPending(clinic.email) ? clinic.email : <a href={`mailto:${clinic.email}`}>{clinic.email}</a>}
			</dd>
		</div>
		<div>
			<dt>Horario</dt>
			{
				clinic.hours.map((h) => (
					<dd class={pending(h.days)}>
						{h.days} · {h.time}
					</dd>
				))
			}
		</div>
		{
			clinic.social.length > 0 && (
				<div>
					<dt>Redes</dt>
					{clinic.social.map((s) => (
						<dd>
							<a href={s.href} rel="noopener">
								{s.label}
							</a>
						</dd>
					))}
				</div>
			)
		}
	</dl>
</section>

<style>
	.contact {
		max-width: 1080px;
		margin: 0 auto;
		padding: 96px 16px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
	}

	.contact h2 {
		margin: 12px 0 0;
		font-size: 3rem;
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(90deg, #000000, #666666);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.btn {
		display: inline-block;
		margin-top: 32px;
		padding: 8px 12px;
		border-radius: 9999px;
		background: var(--ink);
		color: #fff;
		font-size: 1rem;
		line-height: 1.5rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform 300ms var(--ease);
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn:active {
		transform: scale(0.98);
	}

	.btn.is-disabled {
		opacity: 0.4;
		cursor: not-allowed;
		transform: none;
	}

	.contact__data {
		margin: 0;
		display: grid;
		gap: 24px;
		align-content: start;
	}

	.contact__data dt {
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		color: var(--ink-soft);
	}

	.contact__data dd {
		margin: 4px 0 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
	}

	.contact__data a {
		color: var(--ink);
	}

	/* Datos aún sin rellenar: visibles pero marcados. */
	.contact__data dd.pending {
		color: #9a5b2e;
		background: #fbf1e6;
		border: 1px dashed #d9a877;
		border-radius: 8px;
		padding: 4px 8px;
		display: inline-block;
	}

	@media (max-width: 860px) {
		.contact {
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.contact h2 {
			font-size: 2.25rem;
			line-height: 2.5rem;
		}
	}
</style>
