---
// Cómo es la primera visita: tres pasos, sin datos inventados (precios, plazos...).
const steps = [
	{
		title: 'Pides tu cita',
		body: 'Nos escribes o llamas, nos cuentas qué te preocupa y buscamos el día que mejor te venga.',
	},
	{
		title: 'Valoramos tu caso',
		body: 'En la primera visita revisamos tu boca o tu piel con calma y resolvemos todas tus dudas.',
	},
	{
		title: 'Decidimos juntos el plan',
		body: 'Te explicamos cada opción y sus pasos para que elijas el tratamiento con toda la información.',
	},
];
---

<section id="primera-visita" class="visit reveal" aria-labelledby="visita-title">
	<header class="visit__head">
		<p class="eyebrow">Tu primera visita</p>
		<h2 id="visita-title" class="text-gradient">Así empezamos a cuidarte</h2>
	</header>

	<ol class="visit__steps">
		{
			steps.map((s, i) => (
				<li class="visit__step stagger" style={`--i: ${i}`}>
					<span class="visit__num" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<h3>{s.title}</h3>
					<p>{s.body}</p>
				</li>
			))
		}
	</ol>
</section>

<style>
	.visit {
		max-width: 1200px;
		margin: 0 auto;
		padding: 96px 32px;
	}

	.visit__head {
		max-width: 680px;
	}

	.visit__head h2 {
		margin: 24px 0 0;
		font-size: 3.75rem;
		line-height: 1;
	}

	.visit__steps {
		list-style: none;
		margin: 80px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 48px;
	}

	/* Sin cajas: un filete arriba y un número grande y fino. */
	.visit__step {
		padding-top: 32px;
		border-top: 1px solid var(--line-strong);
	}

	.visit__num {
		display: block;
		font-size: 4.5rem;
		line-height: 1;
		font-weight: 200;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
		color: var(--accent);
	}

	.visit__step h3 {
		margin: 32px 0 0;
		font-size: 1.5rem;
		line-height: 2rem;
	}

	.visit__step p {
		margin: 12px 0 0;
		font-size: 1rem;
		line-height: 1.5rem;
		color: var(--ink-soft);
	}

	@media (max-width: 860px) {
		.visit {
			padding: 80px 16px;
		}

		.visit__head h2 {
			font-size: 2.25rem;
			line-height: 2.5rem;
		}

		.visit__steps {
			margin-top: 48px;
			grid-template-columns: 1fr;
		}

		.visit__num {
			font-size: 3rem;
		}
	}
</style>
