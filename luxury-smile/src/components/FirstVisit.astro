---
// Cómo es la primera visita: tres pasos, sin datos inventados (precios, plazos...).
const steps = [
	{
		title: 'Pides tu cita',
		body: 'Nos escribes o llamas, nos cuentas qué te preocupa y buscamos el día que mejor te venga.',
	},
	{
		title: 'Valoramos tu caso',
		body: 'En la primera visita revisamos tu boca o tu piel con calma y resolvemos todas tus dudas.',
	},
	{
		title: 'Decidimos juntos el plan',
		body: 'Te explicamos cada opción y sus pasos para que elijas el tratamiento con toda la información.',
	},
];
---

<section id="primera-visita" class="visit reveal" aria-labelledby="visita-title">
	<header class="visit__head">
		<p class="eyebrow">Tu primera visita</p>
		<h2 id="visita-title" class="text-gradient">Así empezamos a cuidarte</h2>
	</header>

	<ol class="visit__steps">
		{
			steps.map((s, i) => (
				<li class="visit__step">
					<span class="visit__num" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<h3>{s.title}</h3>
					<p>{s.body}</p>
				</li>
			))
		}
	</ol>
</section>

<style>
	.visit {
		max-width: 1200px;
		margin: 0 auto;
		padding: 96px 32px;
	}

	.visit__head {
		max-width: 680px;
	}

	.visit__head h2 {
		margin: 12px 0 0;
		font-size: 3rem;
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.visit__steps {
		list-style: none;
		margin: 64px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.visit__step {
		padding: 32px;
		border-radius: 24px;
		background: color-mix(in srgb, var(--surface) 72%, transparent);
		border: 1px solid var(--line);
	}

	.visit__num {
		display: inline-grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 9999px;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 700;
		color: var(--accent-ink);
		background: var(--accent);
	}

	.visit__step h3 {
		margin: 24px 0 0;
		font-size: 1.25rem;
		line-height: 1.75rem;
		font-weight: 700;
	}

	.visit__step p {
		margin: 8px 0 0;
		font-size: 1rem;
		line-height: 1.5rem;
		color: var(--ink-soft);
	}

	@media (max-width: 860px) {
		.visit {
			padding: 64px 16px;
		}

		.visit__head h2 {
			font-size: 2.25rem;
			line-height: 2.5rem;
		}

		.visit__steps {
			margin-top: 48px;
			grid-template-columns: 1fr;
		}
	}
</style>
