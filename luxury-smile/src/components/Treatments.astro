---
import { Image } from 'astro:assets';
import { treatments } from '../data/clinic';
---

<section id="tratamientos" class="treatments reveal" aria-labelledby="tratamientos-title">
	<header class="treatments__head">
		<p class="eyebrow">Tratamientos</p>
		<h2 id="tratamientos-title" class="text-gradient">Lo que podemos hacer por ti</h2>
		<p class="treatments__lead">
			Odontología y medicina estética en una misma clínica, con un plan explicado paso a paso.
		</p>
	</header>

	<ul class="treatments__grid">
		{
			treatments.map((t, i) => (
				<li id={`tratamiento-${t.id}`} class="stagger" style={`--i: ${i}`}>
					<article class="treatment">
						<div class="treatment__media">
							<Image
								class="treatment__img"
								src={t.image}
								alt=""
								widths={[320, 480, 640]}
								sizes="(max-width: 860px) 100vw, 280px"
								loading="lazy"
							/>
						</div>
						<p class="treatment__meta">
							<span>{String(i + 1).padStart(2, '0')}</span>
							<span>{t.group}</span>
						</p>
						<h3 class="treatment__name">{t.name}</h3>
						<p class="treatment__desc">{t.description}</p>
						<a class="treatment__link link-arrow" href={t.href}>
							Pedir información
							<span class="visually-hidden"> sobre {t.name}</span>
						</a>
					</article>
				</li>
			))
		}
	</ul>
</section>

<style>
	.treatments {
		max-width: 1200px;
		margin: 0 auto;
		padding: 96px 32px;
	}

	.treatments__head {
		max-width: 680px;
	}

	.treatments__head h2 {
		margin: 24px 0 0;
		font-size: 3.75rem;
		line-height: 1;
	}

	.treatments__lead {
		margin: 24px 0 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
		color: var(--ink-soft);
	}

	.treatments__grid {
		list-style: none;
		margin: 80px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 64px 32px;
	}

	.treatment {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	/* La foto se acerca despacio al pasar el ratón; el marco no se mueve. */
	.treatment__media {
		overflow: hidden;
		border-radius: 16px;
		background: var(--surface-raised);
		border: 1px solid var(--line);
	}

	.treatment__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		filter: saturate(0.9);
		transition:
			transform 700ms var(--ease),
			filter 500ms var(--ease);
	}

	.treatment:hover .treatment__img {
		transform: scale(1.05);
		filter: saturate(1);
	}

	.treatment__meta {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin: 24px 0 0;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-variant-numeric: tabular-nums;
		color: var(--accent);
	}

	.treatment__meta span:last-child {
		color: var(--ink-soft);
	}

	.treatment__name {
		margin: 16px 0 0;
		font-size: 1.5rem;
		line-height: 2rem;
	}

	.treatment__desc {
		margin: 8px 0 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--ink-soft);
	}

	.treatment__link {
		margin-top: auto;
		padding-top: 16px;
		align-self: flex-start;
		color: var(--accent);
	}

	@media (max-width: 1100px) {
		.treatments__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 860px) {
		.treatments {
			padding: 80px 16px;
		}

		.treatments__head h2 {
			font-size: 2.25rem;
			line-height: 2.5rem;
		}

		.treatments__grid {
			margin-top: 48px;
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}
</style>
