---
import { specialties, highlights } from '../data/clinic';
---

<section id="tratamientos" class="treatments reveal" aria-labelledby="tratamientos-title">
	<header class="treatments__head">
		<p class="eyebrow">Tratamientos</p>
		<h2 id="tratamientos-title" class="text-gradient">Lo que podemos hacer por ti</h2>
		<p class="treatments__lead">
			Atención odontológica integral para jóvenes y adultos: precisión quirúrgica, estética dental y
			biotecnología para una recuperación más rápida.
		</p>
	</header>

	<!-- Especialidades: un filete arriba, número fino y la lista de servicios. -->
	<ol class="treatments__grid">
		{
			specialties.map((s, i) => (
				<li id={`tratamiento-${s.id}`} class="specialty stagger" style={`--i: ${i}`}>
					<p class="specialty__num" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</p>
					<h3 class="specialty__name">{s.name}</h3>
					<ul class="specialty__services">
						{s.services.map((service) => (
							<li>
								<h4>{service.name}</h4>
								<p>{service.description}</p>
							</li>
						))}
					</ul>
				</li>
			))
		}
	</ol>

	<section class="highlights" aria-labelledby="destacados-title">
		<h3 id="destacados-title" class="eyebrow">Protocolos destacados</h3>
		<ul class="highlights__list">
			{
				highlights.map((h, i) => (
					<li class="stagger" style={`--i: ${i}`}>
						<h4>{h.name}</h4>
						<p>{h.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</section>

<style>
	.treatments {
		max-width: 1200px;
		margin: 0 auto;
		padding: 96px 32px;
	}

	.treatments__head {
		max-width: 680px;
	}

	.treatments__head h2 {
		margin: 24px 0 0;
		font-size: 3.75rem;
		line-height: 1;
	}

	.treatments__lead {
		margin: 24px 0 0;
		font-size: 1.125rem;
		line-height: 1.75rem;
		color: var(--ink-soft);
	}

	.treatments__grid {
		list-style: none;
		margin: 80px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 64px 48px;
	}

	.specialty {
		padding-top: 24px;
		border-top: 1px solid var(--line-strong);
	}

	.specialty__num {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		font-variant-numeric: tabular-nums;
		color: var(--accent);
	}

	.specialty__name {
		margin: 12px 0 0;
		font-size: 1.5rem;
		line-height: 2rem;
	}

	.specialty__services {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		gap: 20px;
	}

	.specialty__services h4,
	.highlights__list h4 {
		margin: 0;
		font-size: 1rem;
		line-height: 1.5rem;
		font-weight: 500;
	}

	.specialty__services p,
	.highlights__list p {
		margin: 4px 0 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--ink-soft);
	}

	.highlights {
		margin-top: 96px;
		padding: 48px;
		border-radius: 24px;
		background: var(--glass);
		backdrop-filter: blur(24px) saturate(1.3);
		-webkit-backdrop-filter: blur(24px) saturate(1.3);
		border: 1px solid var(--line);
	}

	.highlights h3 {
		font-size: 0.75rem;
	}

	.highlights__list {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 32px;
	}

	@media (max-width: 1100px) {
		.highlights__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 860px) {
		.treatments {
			padding: 80px 16px;
		}

		.treatments__head h2 {
			font-size: 2.25rem;
			line-height: 2.5rem;
		}

		.treatments__grid {
			margin-top: 48px;
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.highlights {
			margin-top: 64px;
			padding: 32px 24px;
		}
	}

	@media (max-width: 600px) {
		.highlights__list {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}
</style>
