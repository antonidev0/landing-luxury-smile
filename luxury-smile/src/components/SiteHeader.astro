---
// Cabecera flotante: HTML estático (funciona sin JS). El script solo marca el enlace
// de la sección visible.
import Logo from '../assets/brand/logo.svg';
import { clinic } from '../data/clinic';

const links = [
	{ href: '#top', label: 'Recorrido', section: 'world' },
	{ href: '#tratamientos', label: 'Tratamientos', section: 'tratamientos' },
	{ href: '#contacto', label: 'Contacto', section: 'contacto' },
];
---

<header class="header">
	<div class="header__bar">
		<a class="header__brand" href="#top" aria-label={`${clinic.name}, volver al inicio`}>
			<Logo class="header__logo" aria-hidden="true" />
		</a>
		<nav class="header__nav" aria-label="Principal">
			{
				links.map((l, i) => (
					<a class="header__link" href={l.href} data-section={l.section} aria-current={i === 0 ? 'true' : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>
		<a class="header__cta link-arrow" href="#contacto">Pedir cita</a>
		<button
			class="header__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="menu-movil"
			aria-label="Abrir menú"
		>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>
	</div>
</header>

<!-- Menú móvil: panel a pantalla completa. Los enlaces entran uno tras otro. -->
<div id="menu-movil" class="menu" hidden>
	<nav class="menu__nav" aria-label="Principal">
		{
			links.map((l, i) => (
				<a class="menu__link" href={l.href} style={`--i: ${i}`}>
					{l.label}
				</a>
			))
		}
		<a class="menu__cta btn" href="#contacto" style={`--i: ${links.length}`}>
			Pedir cita
		</a>
	</nav>
</div>

<script>
	// La sección actual es la última cuya parte superior ya pasó la mitad de la pantalla.
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.header__link'));
	const sections = links
		.map((link) => ({ link, el: document.getElementById(link.dataset.section ?? '') }))
		.filter((s): s is { link: HTMLAnchorElement; el: HTMLElement } => !!s.el);

	const setCurrent = (current: HTMLAnchorElement) =>
		links.forEach((l) => (l === current ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));

	const io = new IntersectionObserver(
		() => {
			const mid = window.innerHeight / 2;
			const passed = sections.filter((s) => s.el.getBoundingClientRect().top < mid);
			setCurrent((passed.at(-1) ?? sections[0]).link);
		},
		{ rootMargin: '-50% 0px -50% 0px' },
	);
	sections.forEach((s) => io.observe(s.el));

	// Menú móvil: abre/cierra con el botón, se cierra con Escape o al elegir un enlace.
	const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
	const menu = document.getElementById('menu-movil');
	if (toggle && menu) {
		let closeTimer = 0;
		const setOpen = (open: boolean) => {
			window.clearTimeout(closeTimer);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			document.documentElement.classList.toggle('menu-open', open);
			if (open) {
				menu.hidden = false;
				requestAnimationFrame(() => menu.classList.add('is-open'));
			} else {
				menu.classList.remove('is-open');
				// Se oculta del todo cuando termina la transición de salida.
				closeTimer = window.setTimeout(() => (menu.hidden = true), 500);
			}
		};
		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		menu.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});
		window.matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && setOpen(false));
	}
</script>

<style>
	.header {
		position: fixed;
		top: 16px;
		left: 0;
		right: 0;
		z-index: 70;
		display: flex;
		justify-content: center;
		padding: 0 16px;
		pointer-events: none;
	}

	.header__bar {
		display: flex;
		align-items: center;
		gap: 32px;
		padding: 8px 8px 8px 24px;
		border-radius: 9999px;
		background: var(--glass);
		backdrop-filter: blur(24px) saturate(1.3);
		-webkit-backdrop-filter: blur(24px) saturate(1.3);
		border: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
		box-shadow: 0 8px 32px color-mix(in srgb, #000000 24%, transparent);
		pointer-events: auto;
	}

	.header__brand {
		display: flex;
		color: var(--ink);
		border-radius: 8px;
	}

	.header__logo {
		height: 28px;
		width: auto;
	}

	.header__nav {
		display: flex;
		gap: 4px;
	}

	.header__link {
		padding: 8px 12px;
		border-radius: 9999px;
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-soft);
		text-decoration: none;
		transition:
			color 300ms var(--ease),
			background-color 300ms var(--ease);
	}

	.header__link:hover {
		color: var(--ink);
	}

	.header__link[aria-current='true'] {
		color: var(--ink);
		background: color-mix(in srgb, var(--ink) 10%, transparent);
	}

	.header__cta {
		padding: 8px 16px;
		border-radius: 9999px;
		background: var(--accent);
		color: var(--accent-ink);
		transition: transform 300ms var(--ease);
	}

	.header__cta:hover {
		transform: translateY(-2px);
	}

	.header__cta:active {
		transform: scale(0.98);
	}

	.header__toggle {
		display: none;
	}

	.menu {
		position: fixed;
		inset: 0;
		z-index: 65;
		display: flex;
		align-items: flex-end;
		padding: 96px 24px 48px;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(32px) saturate(1.3);
		-webkit-backdrop-filter: blur(32px) saturate(1.3);
		opacity: 0;
		transition: opacity 500ms var(--ease);
	}

	.menu.is-open {
		opacity: 1;
	}

	/* `display: flex` anula el atributo hidden: sin esto el menú, invisible, tapaba toda
	   la página (bloqueaba clics y dejaba una capa con desenfoque encima del vídeo). */
	.menu[hidden] {
		display: none;
	}

	.menu__nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
		width: 100%;
	}

	.menu__link,
	.menu__cta {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 500ms var(--ease),
			transform 500ms var(--ease);
		transition-delay: calc(var(--i) * 60ms);
	}

	.menu.is-open .menu__link,
	.menu.is-open .menu__cta {
		opacity: 1;
		transform: none;
	}

	.menu__link {
		width: 100%;
		padding-bottom: 24px;
		border-bottom: 1px solid var(--line);
		font-size: 2.25rem;
		line-height: 2.5rem;
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--ink);
		text-decoration: none;
	}

	.menu__cta {
		margin-top: 16px;
	}

	@media (max-width: 860px) {
		.header {
			top: 12px;
		}

		.header__nav {
			display: none;
		}

		.header__cta {
			padding: 8px 12px;
		}

		/* Con el menú abierto la página de detrás no se desplaza. */
		:global(html.menu-open) {
			overflow: hidden;
		}

		.header__bar {
			gap: 16px;
			padding: 4px 4px 4px 16px;
		}

		.header__logo {
			height: 24px;
		}

		/* Botón de menú: dos líneas que giran hasta formar una X. */
		.header__toggle {
			position: relative;
			display: grid;
			place-items: center;
			width: 40px;
			height: 40px;
			padding: 0;
			border: 0;
			border-radius: 9999px;
			background: color-mix(in srgb, var(--ink) 10%, transparent);
			color: var(--ink);
			cursor: pointer;
		}

		.header__toggle span {
			position: absolute;
			width: 16px;
			height: 1.5px;
			border-radius: 2px;
			background: currentColor;
			transition: transform 500ms var(--ease);
		}

		.header__toggle span:first-child {
			transform: translateY(-3px);
		}

		.header__toggle span:last-child {
			transform: translateY(3px);
		}

		.header__toggle[aria-expanded='true'] span:first-child {
			transform: rotate(45deg);
		}

		.header__toggle[aria-expanded='true'] span:last-child {
			transform: rotate(-45deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu__link,
		.menu__cta {
			transform: none;
			transition-delay: 0ms;
		}

		.header__toggle span {
			transition: none;
		}
	}
</style>
