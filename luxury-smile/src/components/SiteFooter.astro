---
import Logo from '../assets/brand/logo.svg';
import { clinic } from '../data/clinic';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__brand">
		<Logo class="footer__logo" aria-hidden="true" />
		<p>{clinic.tagline}</p>
	</div>
	<nav class="footer__nav" aria-label="Legal">
		<a href="/aviso-legal">Aviso legal</a>
		<a href="/privacidad">Privacidad</a>
	</nav>
	<p class="footer__copy">© {year} {clinic.name}</p>
</footer>

<style>
	.footer {
		max-width: 1200px;
		margin: 0 auto;
		padding: 48px 32px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--ink-soft);
		border-top: 1px solid var(--line);
	}

	.footer p {
		margin: 0;
	}

	.footer__brand {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.footer__logo {
		height: 32px;
		width: auto;
		color: var(--ink);
	}

	.footer__nav {
		display: flex;
		gap: 24px;
	}

	.footer a {
		color: var(--ink-soft);
		text-decoration: none;
		transition: color 300ms var(--ease);
	}

	.footer a:hover {
		color: var(--ink);
	}

	@media (max-width: 860px) {
		.footer {
			padding: 32px 16px 48px;
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
